{
  "apiVersion": "neuron/v1",
  "kind": "CapabilityRuntime",
  "metadata": {
    "name": "{{.Type}}",
    "version": "{{.Version}}",
    "description": "{{.Description}}"
  },
  "runtime": {
    "type": "process",
    "entrypoint": "{{.BinaryName}}",
    "protocol": "neuron/capability-runtime-v1-json",
    "maxWorkers": 4
  },
  "capabilities": [
    "{{.CapabilityName}}"
  ],
  "features": [],
  "build": {
    "command": "./build.sh"
  },
  "artifact": {
    "path": "{{.BinaryName}}"
  },
  "platforms": {
    "{{.Platform}}": {
      "artifact": "{{.BinaryName}}"
    }
  }
}