{
  "name": "@neuron/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for defining Neuron systems",
  "license": "MIT",
  "author": "Muhammad Jay",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muhammad-Jay/neuron.git",
    "directory": "packages/system-sdks/typescript"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "neuron-sdk": "./dist/cli/command.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "tsup": "^8.0.1",
    "typescript": "5.9.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  }
}